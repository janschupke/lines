{
  "name": "react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "check": "npm run knip && npm run typecheck && npm run test && npm run lint:fix && npm run format && npm run build",
    "start": "next start",
    "tokens": "tsx scripts/build-tokens.ts",
    "predev": "npm run tokens",
    "prebuild": "npm run tokens",
    "replay": "tsx scripts/replay.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose stop postgres",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "next": "^16.3.1",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.4.2",
    "eslint": "^9.29.0",
    "eslint-config-next": "^16.3.1",
    "fast-check": "^4.9.0",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "knip": "^5.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prisma": "^7.9.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.4"
  }
}
